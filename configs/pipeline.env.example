# Copy this file outside Git tracking, fill server paths, then source it.
# Never commit company paths, tokens, UUID manifests, or model artifacts.

MODEL_PATH=/models/Qwen2.5-VL-7B-Instruct
SAVE_CHECKPOINT_DIR=/work/checkpoints

# Stage 1
TRAIN_DATASET=/work/data/stage1_business_plus_open_hf
EXPERIMENT_NAME=stage1_business_proposal_grpo

# Stage 2 (set MODEL_PATH to Stage-1 checkpoint/huggingface before running)
SFT_DATASET=/work/data/refine_sft_20k.jsonl
OUTPUT_DIR=/work/checkpoints/stage2_refine_sft

# Stage 3 (set REF_MODEL_PATH to merged Stage-2 model before running)
REF_MODEL_PATH=/work/checkpoints/stage2_refine_sft_merged
TRAIN_DATASET=/work/data/stage3_hard_8k_hf
VAL_DATASET=/work/data/stage3_hard_8k_hf
EXPERIMENT_NAME=stage3_business_refine_grpo_8k
